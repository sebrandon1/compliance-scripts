# .env.example - Configuration for compliance-scripts
#
# Copy this file to .env and customize as needed:
#   cp .env.example .env
#
# Environment variables are loaded automatically by scripts that source lib/common.sh

# ============================================================================
# NAMESPACE CONFIGURATION
# ============================================================================

# Namespace where Compliance Operator is installed
COMPLIANCE_NAMESPACE=openshift-compliance

# ============================================================================
# SCAN CONFIGURATION
# ============================================================================

# Default scan profile
# SCAN_PROFILE=ocp4-cis
#
# Default profiles scanned by create-scan.sh (unless --profile or --platform is set):
#   ocp4-e8, rhcos4-e8, ocp4-cis, ocp4-moderate, ocp4-pci-dss, rhcos4-moderate
#
# Filter with: ./core/create-scan.sh --platform ocp|rhcos
# Single profile: ./core/create-scan.sh -p ocp4-moderate
#
# Available profiles (from Compliance Operator ProfileBundles):
#
#   CIS Benchmarks:
#     ocp4-cis              - CIS Red Hat OpenShift Container Platform 4 Benchmark
#     ocp4-cis-1-7          - CIS Red Hat OpenShift Container Platform 4 Benchmark v1.7
#     ocp4-cis-node         - CIS Red Hat OpenShift Container Platform 4 Benchmark (Node level)
#     ocp4-cis-node-1-7     - CIS Red Hat OpenShift Container Platform 4 Benchmark v1.7 (Node level)
#
#   NIST 800-53 Moderate:
#     ocp4-moderate         - NIST 800-53 Moderate-Impact Baseline for Red Hat OpenShift - Platform level
#     ocp4-moderate-rev-4   - NIST 800-53 Moderate-Impact Baseline (Rev 4) - Platform level
#     ocp4-moderate-node    - NIST 800-53 Moderate-Impact Baseline for Red Hat OpenShift - Node level
#     ocp4-moderate-node-rev-4 - NIST 800-53 Moderate-Impact Baseline (Rev 4) - Node level
#     rhcos4-moderate       - NIST 800-53 Moderate-Impact Baseline for Red Hat Enterprise Linux CoreOS
#     rhcos4-moderate-rev-4 - NIST 800-53 Moderate-Impact Baseline (Rev 4) for RHEL CoreOS
#
#   PCI-DSS:
#     ocp4-pci-dss          - PCI-DSS v3.2.1 Control Baseline - Platform level
#     ocp4-pci-dss-3-2      - PCI-DSS v3.2.1 Control Baseline - Platform level
#     ocp4-pci-dss-4-0      - PCI-DSS v4.0.0 Control Baseline - Platform level
#     ocp4-pci-dss-node     - PCI-DSS v3.2.1 Control Baseline - Node level
#     ocp4-pci-dss-node-3-2 - PCI-DSS v3.2.1 Control Baseline - Node level
#     ocp4-pci-dss-node-4-0 - PCI-DSS v4.0.0 Control Baseline - Node level
#
# Use with create-scan.sh: ./core/create-scan.sh -p ocp4-moderate

# Scan schedule (cron format) - default: 1 AM daily
# SCAN_SCHEDULE="0 1 * * *"

# Scan result rotation (number of results to keep)
# ROTATION=3

# ============================================================================
# REMEDIATION COLLECTION
# ============================================================================

# Severity levels to collect (comma-separated: high,medium,low)
SEVERITY_FILTER=high,medium

# OpenShift version for data exports
OCP_VERSION=5.0

# ============================================================================
# DIRECTORY PATHS
# ============================================================================

# Output directory for collected remediations
# REMEDIATION_DIR=./complianceremediations

# Directory containing MachineConfig files for organization
# MACHINECONFIG_DIR=./complianceremediations

# Directory for extra manifests (used by organize-machine-configs.sh)
# EXTRAMANIFESTS_DIR=./extra-manifests

# ============================================================================
# STORAGE CONFIGURATION (for apply-periodic-scan.sh)
# ============================================================================

# Disable PVC creation (use emptyDir instead)
# NO_PVC=false

# Storage class name (auto-detected if not set)
# SC_NAME=

# PVC size for scan results
# RAW_SIZE=1Gi

# ============================================================================
# OPERATOR INSTALLATION
# ============================================================================

# Specific Compliance Operator version (e.g., v1.9.0)
# Leave empty for latest. install-compliance-operator.sh also honors CO_REF.
# COMPLIANCE_OPERATOR_REF=
# CO_REF=v1.9.0

# Use community operator instead of Red Hat certified
# USE_COMMUNITY_OPERATOR=false

# ============================================================================
# IMAGE MIRROR (also set in versions.env)
# ============================================================================

# IMAGE_REGISTRY=quay.io/bapalm
# CO_IMAGE_TAG=v1.9.0
# CONTENT_IMAGE_TAG=v0.1.81

# ============================================================================
# PLATFORM FILTER (create-scan.sh / apply-periodic-scan.sh)
# ============================================================================

# PLATFORM=all
#   ocp    - ocp4-* profiles only
#   rhcos  - rhcos4-* profiles only
#   all    - both (default)

# ============================================================================
# DEBUG OPTIONS
# ============================================================================

# Log level: 0=quiet, 1=error, 2=warn, 3=info (default), 4=debug
# Named aliases: quiet, error, warn, info, debug
# LOG_LEVEL=3

# Enable debug logging (1=enabled, 0=disabled) — older flag; prefer LOG_LEVEL
# DEBUG=0
